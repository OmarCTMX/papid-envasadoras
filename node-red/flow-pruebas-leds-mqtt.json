    "id": "mqtt_broker_leds",
    "type": "mqtt-broker",
    "name": "broker local",
    "broker": "127.0.0.1",
    "port": 1883,
    "clientid": "",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": 4,
    "keepalive": 60,
    "cleansession": true,
    "birthTopic": "",
    "closeTopic": "",
    "willTopic": "",
    "sessionExpiry": ""
  },
