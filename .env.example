# ---------- Dashboard de Envasadoras (un silo) ----------
REGION=Cotija
MAQUINA=B2-A Silo 1

# Código EXACTO de este silo (B2-A-silo-1 ... B2-A-silo-4).
# El POST /api/orden con "maquina": "B2 (A) 1" se valida contra este valor.
MACHINE_CODE=B2-A-silo-1

# Envasadoras (bolas) del silo: 2 en silos 1 y 4, 3 en silos 2 y 3.
NUM_ENVASADORAS=2

PORT=3000

# Token del POST/DELETE /api/orden ("Authorization: Bearer <token>").
# Vacío = API abierta en la red.
API_TOKEN=changeme

# Reseteo diario (HH:MM). Vacío u "off" = sin reseteo.
RESET_HORA=18:00

# ---------- NATS ----------
# Desde Docker: usa la IP real del NATS o host.docker.internal (no localhost).
NATS_URL=nats://host.docker.internal:4222
NATS_USER=changeme
NATS_PASS=changeme
