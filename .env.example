# ---------- Dashboard de Envasadoras ----------
# Región y máquina que se muestran en el header/footer
REGION=Cotija
MAQUINA=Envasadora-1

# Código EXACTO de esta envasadora. El dashboard escucha
# papid.envasadora.<MACHINE_CODE> y solo aplica los mensajes cuyo
# machine_code coincide con este valor.
MACHINE_CODE=envasadora-1

# Puerto del servidor web (default 3000)
PORT=3000

# ---------- NATS ----------
# URL del servidor NATS de las envasadoras (IP distinta al de personal).
NATS_URL=nats://localhost:4222

# Credenciales
NATS_USER=papid
NATS_PASS=papid2024
